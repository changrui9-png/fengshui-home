# 复制为 .env 后由启动脚本读取。不要把真实密钥提交到仓库。
# 不填写时，网站仍可使用示例、手绘、照片底图、旁白文字摘录和 JSON 导入。
# 此时不会分析视频，界面会写明「未配置，未分析」。

# openai | gemini | openai-compatible
AI_PROVIDER=

# 只放在服务器环境变量里，前端打包不会读取它。
AI_API_KEY=

# 例如 gpt-4o-mini 或 gemini-2.0-flash。只允许字母、数字、点、下划线、冒号和短横线。
AI_MODEL=

# 仅 openai-compatible 需要。必须是 https，主机名还必须出现在 AI_ALLOWED_HOSTS。
AI_BASE_URL=

# 逗号分隔。请求不会发往名单以外的主机，也不会跟随重定向。
AI_ALLOWED_HOSTS=api.openai.com,generativelanguage.googleapis.com

AI_TIMEOUT_MS=45000
AI_MAX_REQUESTS_PER_HOUR=6
PORT=8787
